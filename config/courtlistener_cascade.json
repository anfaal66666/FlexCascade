{
  "dataset": {
    "source": "courtlistener",
    "courtlistener_dir": "data/courtlistener",
    "courtlistener_aggregate_level": "cluster",
    "courtlistener_require_state": true,
    "prepared_path": "data/processed/courtlistener_training.csv.gz"
  },
  "max_rows": 50000,
  "top_n_states": 15,
  "seed": 42,
  "min_issuer_count": 10,
  "split": "train",
  "cache_dir": "cache",
  "processed_dir": "data/processed",
  "results_dir": "results/courtlistener_cascade",
  "models_dir": "results/courtlistener_cascade/models",
  "embedding": {
    "strategy": "tfidf"
  },
  "models": {
    "svm": {
      "cost": 1.0,
      "type": 0,
      "epsilon": 0.1
    },
    "random_forest": {
      "ntree": 200,
      "mtry": 10,
      "nodesize": 1
    },
    "xgboost": {
      "eta": 0.1,
      "max_depth": 6,
      "nrounds": 100
    }
  },
  "comparison_runs": [
    {
      "name": "svm_cascade",
      "hierarchy": {
        "stage1_model": "svm",
        "stage2_model": "svm",
        "fallback_model": "svm"
      }
    },
    {
      "name": "random_forest_cascade",
      "hierarchy": {
        "stage1_model": "random_forest",
        "stage2_model": "random_forest",
        "fallback_model": "random_forest"
      }
    },
    {
      "name": "xgboost_cascade",
      "hierarchy": {
        "stage1_model": "xgboost",
        "stage2_model": "xgboost",
        "fallback_model": "xgboost"
      }
    }
  ]
}
